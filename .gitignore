# ============================================================
# Sensitive files - NEVER COMMIT
# ============================================================

# Files containing sensitive names
**/*secret*
**/*secrets*
**/*password*
**/*passwd*
**/*credential*
**/*credentials*
**/*token*

# Common secret/config files
**/secrets.json
**/credentials.json
**/azurecreds.json
**/service-principal.json

# Azure credentials
**/.azure/

# Environment files
.env
.env.*
!.env.example

# Certificates / private keys
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.jks
**/*.keystore

# ============================================================
# Terraform
# ============================================================

# Terraform state can contain secrets
**/*.tfstate
**/*.tfstate.*

# Terraform variable files can contain passwords/secrets
**/*.tfvars
**/*.tfvars.json

# Terraform working directory
**/.terraform/

# ============================================================
# Logs - may contain sensitive information
# ============================================================

**/*.log
**/logs/

# ============================================================
# Backup / temporary files
# ============================================================

*.bak
*.backup
*.tmp
*.temp
*~
# Large/generated files
**/*.msi
**/.terraform/
**/output/
**/ocp/capacity_report_*/
Azure-Scripts/Appgw/AzureCLI.msi
autoshutdown/.terraform/
ocp/openshift-capacity-planner/output/
ocp/openshift-capacity-planner/live-dashboard/capacity-planner/output/
ocp/openshift-capacity-planner/live-dashboard/capacity-planner/oc
# ============================================================
# OS files
# ============================================================

Thumbs.db
Desktop.ini

# ============================================================
# IDE
# ============================================================

.vscode/
.idea/

