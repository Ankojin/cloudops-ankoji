# Default behavior
* text=auto

# ---- Linux / Bash / configs (LF) ----
*.sh text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ---- Windows scripts (CRLF) ----
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ---- Certificates (no change) ----
*.crt binary
*.pem binary
*.cer binary