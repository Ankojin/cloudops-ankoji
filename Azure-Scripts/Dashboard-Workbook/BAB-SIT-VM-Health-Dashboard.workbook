      "styleSettings": { "showBorder": true },
      "name": "DrillStopped"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/deallocated'\n| extend OSType = tostring(properties.storageProfile.osDisk.osType)\n| extend VMSize = tostring(properties.hardwareProfile.vmSize)\n| project VMName=name, ResourceGroup=resourceGroup, Location=location, OSType, VMSize\n| order by VMName asc",
        "size": 0,
        "title": "Deallocated VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": ["/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"]
      },
      "conditionalVisibility": {
        "parameterName": "DrillTile",
        "comparison": "isEqualTo",
        "value": "deallocated"
      },
      "styleSettings": { "showBorder": true },
      "name": "DrillDeallocated"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Windows = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'Logical Disk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=round(avg(CounterValue),1) by Computer, Disk=InstanceName\n| where FreePct < 10;\nlet Linux = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'LogicalDisk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=round(avg(CounterValue),1) by Computer, Disk=InstanceName\n| where FreePct < 10;\nunion Windows, Linux\n| summarize FreePct=min(FreePct) by Computer, Disk\n| order by FreePct asc",
        "size": 0,
        "title": "Critical Disk — Disks with <10% Free Space",
        "noDataMessage": "No critical disk alerts.",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": ["/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"],
        "gridSettings": {
          "formatRules": [
            {
              "columnMatch": "FreePct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "redBright",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true
        }
      },
      "conditionalVisibility": {
        "parameterName": "DrillTile",
        "comparison": "isEqualTo",
        "value": "critical_disk"
      },
      "styleSettings": { "showBorder": true },
      "name": "DrillCriticalDisk"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where CounterName == '% Processor Time'\n| where InstanceName == '_Total'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where TimeGenerated > ago(1h)\n| summarize AvgCPU=round(avg(CounterValue),1) by Computer\n| where AvgCPU > 90\n| order by AvgCPU desc",
        "size": 0,
        "title": "VMs with CPU >90% (last 1h avg)",
        "noDataMessage": "No VMs with CPU above 90%.",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
