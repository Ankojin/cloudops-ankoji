            "type": 1,
            "value": ""
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "Parameters"
    },
    {
      "type": 1,
      "content": {
        "json": "<div style=\"background:linear-gradient(135deg,#0078d4 0%,#005a9e 100%);padding:16px 24px;border-radius:6px;margin-bottom:4px\"><span style=\"color:#ffffff;font-size:22px;font-weight:700;font-family:'Segoe UI',sans-serif;letter-spacing:0.3px\">🖥️ BAB SIT — VM Health Dashboard</span></div>"
      },
      "name": "title"
    },
    {
      "type": 1,
      "content": {
        "json": "<h3 style=\"color:#0078d4;border-left:4px solid #0078d4;padding-left:12px;font-family:'Segoe UI',sans-serif;margin:16px 0 4px 0\">📊 VM Summary</h3>"
      },
      "name": "section-summary"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| summarize TotalVMs=count()",
        "size": 4,
        "title": "Total VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "TotalVMs",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/running'\n| summarize RunningVMs=count()",
        "size": 4,
        "title": "Running VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "OnlineVMs",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState !in~ ('PowerState/running','PowerState/deallocated')\n| summarize StoppedVMs=count()",
        "size": 4,
        "title": "Stopped VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "OfflineVMs",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/deallocated'\n| summarize DeallocatedVMs=count()",
        "size": 4,
        "title": "Deallocated VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "DeallocatedVMs",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/running'\n| extend JoinVMId = tolower(id)\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.devtestlab/schedules'\n    | extend JoinVMId = tolower(tostring(properties['targetResourceId']))\n    | extend AutoShutdownStatus = tostring(properties['status'])\n    | project JoinVMId, AutoShutdownStatus\n) on JoinVMId\n| extend AutoShutdownStatus = iff(isempty(AutoShutdownStatus), 'Disabled', AutoShutdownStatus)\n| where AutoShutdownStatus =~ 'Enabled'\n| summarize AutoShutdownEnabled=count()",
        "size": 4,
        "title": "Auto Shutdown Enabled",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "AutoShutdownEnabled",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/running'\n| extend JoinVMId = tolower(id)\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.devtestlab/schedules'\n    | extend JoinVMId = tolower(tostring(properties['targetResourceId']))\n    | extend AutoShutdownStatus = tostring(properties['status'])\n    | project JoinVMId, AutoShutdownStatus\n) on JoinVMId\n| extend AutoShutdownStatus = iff(isempty(AutoShutdownStatus), 'Disabled', AutoShutdownStatus)\n| where AutoShutdownStatus =~ 'Disabled'\n| summarize AutoShutdownDisabled=count()",
        "size": 4,
        "title": "Auto Shutdown Disabled",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "AutoShutdownDisabled",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/running'\n| extend JoinVMId = tolower(id)\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.devtestlab/schedules'\n    | extend JoinVMId = tolower(tostring(properties['targetResourceId']))\n    | extend AutoShutdownStatus = tostring(properties['status'])\n    | project JoinVMId, AutoShutdownStatus\n) on JoinVMId\n| extend AutoShutdownStatus = iff(isempty(AutoShutdownStatus), 'Disabled', AutoShutdownStatus)\n| summarize TotalRunningVMs = count(), EnabledVMs = countif(AutoShutdownStatus =~ 'Enabled')\n| extend AutoShutdownEnabledPercent = strcat(tostring(round(todouble(EnabledVMs) * 100.0 / todouble(TotalRunningVMs), 1)), '%')\n| project AutoShutdownEnabledPercent",
        "size": 4,
        "title": "Auto Shutdown Enabled %",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ]
      },
      "customWidth": "14",
      "name": "AutoShutdownEnabledPercent",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Windows = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'Logical Disk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=avg(CounterValue) by Computer, InstanceName\n| where FreePct < 10\n| project Computer;\nlet Linux = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'LogicalDisk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=avg(CounterValue) by Computer, InstanceName\n| where FreePct < 10\n| project Computer;\nunion Windows, Linux\n| summarize CriticalServers=dcount(Computer)",
        "size": 4,
        "title": "Critical Disk Servers (<10%)",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ]
      },
      "customWidth": "14",
      "name": "CriticalDiskAlerts",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where CounterName == '% Processor Time'\n| where InstanceName == '_Total'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize AvgCPU=avg(CounterValue) by Computer\n| where AvgCPU > 90\n| summarize VMsHighCPU=count()",
        "size": 4,
        "title": "CPU > 90%",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ]
      },
      "customWidth": "14",
      "name": "HighCPUVMs",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where CounterName in ('% Committed Bytes In Use','% Used Memory')\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize AvgMemory=avg(CounterValue) by Computer\n| where AvgMemory > 90\n| summarize VMsHighMemory=count()",
        "size": 4,
        "title": "Memory > 90%",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ]
      },
      "customWidth": "14",
      "name": "HighMemoryVMs",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 1,
      "content": {
        "json": "<div style=\"background:#fff3cd;border:1px solid #ffc107;padding:10px 14px;border-radius:4px;margin:8px 0 4px 0;font-family:'Segoe UI',sans-serif;color:#333;font-size:13px\">⬇️ <strong>Drill-down navigation:</strong> Click a category tab below — the filtered VM list appears directly beneath the tab bar. Scroll down if needed to see results.</div>"
      },
      "name": "DrillTileHint"
