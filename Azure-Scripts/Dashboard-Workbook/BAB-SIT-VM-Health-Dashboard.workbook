    {
      "type": 1,
      "content": {
        "json": "<h3 style=\"color:#0078d4;border-left:4px solid #0078d4;padding-left:12px;font-family:'Segoe UI',sans-serif;margin:24px 0 4px 0\">🔍 Operational Views</h3>"
      },
      "name": "section-operational"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| where isempty(\"{VM}\") or name =~ \"{VM}\"\n| extend\n    JoinSub = subscriptionId,\n    JoinRG = tolower(resourceGroup),\n    JoinVMId = tolower(id),\n    PowerState = tostring(properties.extended.instanceView.powerState.displayStatus),\n    OSType = tostring(properties.storageProfile.osDisk.osType),\n    VMSize = tostring(properties.hardwareProfile.vmSize),\n    VMInsightsUrl = strcat('https://portal.azure.com/#resource', id, '/insights/performance')\n| join kind=leftouter (\n    ResourceContainers\n    | where type =~ 'microsoft.resources/subscriptions/resourcegroups'\n    | extend\n        JoinSub = subscriptionId,\n        JoinRG = tolower(name)\n    | project\n        JoinSub,\n        JoinRG,\n        ApplicationName = coalesce(tostring(tags['Application name']), tostring(tags['Application Name']), tostring(tags['ApplicationName']), tostring(tags['AppName']), tostring(tags['Project']), tostring(tags['project'])),\n        ApproverName = coalesce(tostring(tags['Approver name']), tostring(tags['Approver Name']), tostring(tags['ApproverName']), tostring(tags['Approver'])),\n        TechnicalOwner = coalesce(tostring(tags['Technical Owner']), tostring(tags['Technical owner']), tostring(tags['TechnicalOwner']), tostring(tags['Tech Owner']), tostring(tags['TechOwner'])),\n        BusinessOwner = coalesce(tostring(tags['Business Owner']), tostring(tags['BusinessOwner']), tostring(tags['Owner'])),\n        Company = coalesce(tostring(tags['Company']), tostring(tags['company'])),\n        CostCenter = coalesce(tostring(tags['Cost Center']), tostring(tags['CostCenter']), tostring(tags['Cost center']))\n) on JoinSub, JoinRG\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.devtestlab/schedules'\n    | extend\n        JoinVMId = tolower(tostring(properties['targetResourceId'])),\n        AutoShutdownStatus = tostring(properties['status']),\n        ShutdownTime = tostring(properties['dailyRecurrence']['time'])\n    | project\n        JoinVMId,\n        AutoShutdownStatus,\n        ShutdownTime\n) on JoinVMId\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.network/networkinterfaces'\n    | extend JoinVMId = tolower(tostring(properties['virtualMachine']['id']))\n    | mv-expand ipconfig = properties['ipConfigurations']\n    | extend PrivateIP = tostring(ipconfig['properties']['privateIPAddress'])\n    | where isnotempty(JoinVMId) and isnotempty(PrivateIP)\n    | summarize PrivateIPs = strcat_array(make_set(PrivateIP), ', ') by JoinVMId\n) on JoinVMId\n| extend\n    AutoShutdownStatus = iff(isempty(AutoShutdownStatus), 'Disabled', AutoShutdownStatus),\n    ShutdownTime = iff(isempty(ShutdownTime), '-', ShutdownTime),\n    PrivateIPs = iff(isempty(PrivateIPs), '-', PrivateIPs),\n    ApplicationName = iff(isempty(ApplicationName), '-', ApplicationName),\n    ApproverName = iff(isempty(ApproverName), '-', ApproverName),\n    TechnicalOwner = iff(isempty(TechnicalOwner), '-', TechnicalOwner),\n    BusinessOwner = iff(isempty(BusinessOwner), '-', BusinessOwner),\n    Company = iff(isempty(Company), '-', Company),\n    CostCenter = iff(isempty(CostCenter), '-', CostCenter)\n| project\n    VMName = name,\n    ResourceGroup = resourceGroup,\n    Location = location,\n    OSType,\n    VMSize,\n    PowerState,\n    PrivateIPs,\n    AutoShutdownStatus,\n    ShutdownTime,\n    ApplicationName,\n    ApproverName,\n    TechnicalOwner,\n    BusinessOwner,\n    Company,\n    CostCenter,\n    id,\n    VMInsightsUrl\n| order by VMName asc",
        "size": 0,
        "title": "VM Inventory",
        "showExportToExcel": true,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ],
        "gridSettings": {
          "rowLimit": 1000,
          "filter": true,
          "labelSettings": [
            {
              "columnId": "PrivateIPs",
              "label": "Private IPs"
            },
            {
              "columnId": "AutoShutdownStatus",
              "label": "Auto Shutdown"
            },
            {
              "columnId": "ShutdownTime",
              "label": "Shutdown Time"
            },
            {
              "columnId": "ApplicationName",
              "label": "Application"
            },
            {
              "columnId": "ApproverName",
              "label": "Approver"
            },
            {
              "columnId": "TechnicalOwner",
              "label": "Technical Owner"
            },
            {
              "columnId": "BusinessOwner",
              "label": "Business Owner"
            },
            {
              "columnId": "CostCenter",
              "label": "Cost Center"
            },
            {
              "columnId": "id",
              "label": "Azure VM Blade"
            },
            {
              "columnId": "VMInsightsUrl",
              "label": "VM Insights"
            }
          ]
        }
      },
      "name": "VMInventory",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Windows = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'Logical Disk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=round(avg(CounterValue),1) by Computer, Disk=InstanceName\n| where FreePct < 20;\nlet Linux = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'LogicalDisk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=round(avg(CounterValue),1) by Computer, Disk=InstanceName\n| where FreePct < 20;\nunion Windows, Linux\n| summarize FreePct=min(FreePct) by Computer, Disk\n| extend DiskStatus = iff(FreePct < 10, 'Critical', 'Warning')\n| order by FreePct asc",
        "size": 0,
        "title": "Disk Space Alerts (<20% Free) — avg last 1h, one row per disk",
        "noDataMessage": "No disk space alerts.",
        "showExportToExcel": true,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "rowLimit": 2000,
          "filter": true
        }
      },
      "name": "DiskAlerts",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Heartbeat\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize LastHeartbeat=max(TimeGenerated) by Computer\n| extend Status=iff(LastHeartbeat > ago(15m),'Online','Offline')\n| extend MinutesSinceHeartbeat = datetime_diff('minute', now(), LastHeartbeat)\n| project Computer, Status, LastHeartbeat, MinutesSinceHeartbeat\n| order by Computer asc",
        "size": 0,
        "title": "VM Status Grid",
        "showExportToExcel": true,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "filter": true
        }
      },
      "name": "StatusGrid",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Heartbeat\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize LastHeartbeat=max(TimeGenerated), HeartbeatCount=count() by Computer\n| where LastHeartbeat <= ago(15m)\n| extend MinutesSinceHeartbeat = datetime_diff('minute', now(), LastHeartbeat)\n| project Computer, LastHeartbeat, MinutesSinceHeartbeat, HeartbeatCount\n| order by MinutesSinceHeartbeat desc",
        "size": 0,
        "title": "Failed Heartbeats (>15 min)",
        "noDataMessage": "No failed heartbeats detected.",
        "showExportToExcel": true,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "filter": true
        }
      },
      "name": "FailedHeartbeats",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines/extensions'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| where name in~ ('AzureMonitorWindowsAgent','AzureMonitorLinuxAgent')\n| extend ProvisioningState = tostring(properties.provisioningState)\n| extend VMName = tostring(split(id,'/')[8])\n| extend VMResourceId = tolower(strcat('/subscriptions/', subscriptionId, '/resourcegroups/', resourceGroup, '/providers/microsoft.compute/virtualmachines/', VMName))\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.compute/virtualmachines'\n    | extend PowerState = tostring(properties.extended.instanceView.powerState.displayStatus)\n    | project vmId = tolower(id), PowerState\n) on $left.VMResourceId == $right.vmId\n| where PowerState !in ('VM deallocated', 'VM stopped')\n| project VMName, ExtensionName=name, ResourceGroup=resourceGroup, ProvisioningState\n| order by ProvisioningState asc",
        "size": 0,
        "title": "AMA Extension Health",
        "noDataMessage": "No AMA extensions found. Ensure Azure Monitor Agent is deployed to VMs.",
        "showExportToExcel": true,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ],
        "gridSettings": {
          "filter": true
        }
      },
      "name": "AMAExtensionHealth",
      "styleSettings": {
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines/extensions'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| where name startswith 'DependencyAgent'\n| extend ProvisioningState = tostring(properties.provisioningState)\n| extend VMName = tostring(split(id,'/')[8])\n| extend VMResourceId = tolower(strcat('/subscriptions/', subscriptionId, '/resourcegroups/', resourceGroup, '/providers/microsoft.compute/virtualmachines/', VMName))\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.compute/virtualmachines'\n    | extend PowerState = tostring(properties.extended.instanceView.powerState.displayStatus)\n    | project vmId = tolower(id), PowerState\n) on $left.VMResourceId == $right.vmId\n| where PowerState !in ('VM deallocated', 'VM stopped')\n| project VMName, ExtensionName=name, ResourceGroup=resourceGroup, ProvisioningState\n| order by ProvisioningState asc",
        "size": 0,
        "title": "Dependency Agent Health",
        "noDataMessage": "No Dependency Agent extensions found.",
        "showExportToExcel": true,
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
        ],
        "gridSettings": {
          "filter": true
        }
      },
      "name": "DependencyAgentHealth",
      "styleSettings": {
        "showBorder": true
      }
    }
  ],
