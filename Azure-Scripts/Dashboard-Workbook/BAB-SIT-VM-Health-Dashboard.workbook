    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend PowerState = tostring(properties.extended.instanceView.powerState.displayStatus)\n| extend OSType = tostring(properties.storageProfile.osDisk.osType)\n| extend VMSize = tostring(properties.hardwareProfile.vmSize)\n| project VMName=name, ResourceGroup=resourceGroup, Location=location, OSType, VMSize, PowerState\n| order by VMName asc",
        "size": 0,
        "title": "All VMs",
        "queryType": 1,
