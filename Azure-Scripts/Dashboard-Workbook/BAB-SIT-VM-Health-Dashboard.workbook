    {
      "type": 1,
      "content": {
        "json": "<h3 style=\"color:#0078d4;border-left:4px solid #0078d4;padding-left:12px;font-family:'Segoe UI',sans-serif;margin:24px 0 4px 0\">📈 Performance Charts</h3>"
      },
      "name": "section-charts"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where CounterName == '% Processor Time'\n| where InstanceName == '_Total'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize AvgCPU=avg(CounterValue) by bin(TimeGenerated,5m), Computer\n| order by TimeGenerated asc",
        "size": 0,
        "title": "CPU Trends",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "visualization": "timechart"
      },
      "customWidth": "50",
      "styleSettings": {
        "showBorder": true
      },
      "name": "CPUTrends"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where CounterName in ('% Committed Bytes In Use','% Used Memory')\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize AvgMemory=avg(CounterValue) by bin(TimeGenerated,5m), Computer\n| order by TimeGenerated asc",
        "size": 0,
        "title": "Memory Trends",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "visualization": "timechart"
      },
      "customWidth": "50",
      "styleSettings": {
        "showBorder": true
      },
      "name": "MemoryTrends"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where (ObjectName == 'Network' and CounterName in ('Total Bytes Transmitted','Total Bytes Received','Total Bytes'))\n    or (ObjectName == 'Network Adapter' and CounterName in ('Bytes Received/sec','Bytes Sent/sec','Bytes Total/sec'))\n| summarize AvgBytes=avg(CounterValue) by bin(TimeGenerated,5m), Computer, CounterName\n| order by TimeGenerated asc",
        "size": 0,
        "title": "Network Trends (Bytes/sec)",
        "noDataMessage": "No network counter data. Run: Perf | where CounterName contains 'Byte' | distinct ObjectName, CounterName | take 20",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "visualization": "timechart"
      },
      "customWidth": "50",
      "styleSettings": {
        "showBorder": true
      },
      "name": "NetworkTrends"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let WinDisk = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where ObjectName == 'Logical Disk'\n| where CounterName == '% Free Space'\n| where InstanceName == '_Total'\n| summarize AvgFree=avg(CounterValue) by bin(TimeGenerated,5m), Computer;\nlet LinuxDisk = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where ObjectName == 'LogicalDisk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize AvgFree=avg(CounterValue) by bin(TimeGenerated,5m), Computer;\nunion WinDisk, LinuxDisk\n| summarize AvgFree=avg(AvgFree) by TimeGenerated, Computer\n| extend DiskUsedPct=round(100 - AvgFree, 1)\n| project TimeGenerated, Computer, DiskUsedPct\n| order by TimeGenerated asc",
        "size": 0,
        "title": "Disk Utilization % Used (avg across all mounts)",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "visualization": "timechart",
        "chartSettings": {
          "ySettings": {
            "min": 0,
            "max": 100
          },
          "hideLegend": true
        }
      },
      "customWidth": "50",
      "styleSettings": {
        "showBorder": true
      },
      "name": "DiskUtilization"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Windows = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'Logical Disk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=round(avg(CounterValue),1) by Computer, Disk=InstanceName\n| where FreePct < 20;\nlet Linux = Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where TimeGenerated > ago(1h)\n| where ObjectName == 'LogicalDisk'\n| where CounterName == '% Free Space'\n| where InstanceName !~ '_Total'\n| where InstanceName !startswith 'HarddiskVolume'\n| summarize FreePct=round(avg(CounterValue),1) by Computer, Disk=InstanceName\n| where FreePct < 20;\nunion Windows, Linux\n| summarize FreePct=min(FreePct) by Computer, Disk\n| extend DiskStatus = iff(FreePct < 10, 'Critical', 'Warning')\n| order by FreePct asc",
        "size": 0,
        "title": "Disk Space Alerts (<20% Free) — avg last 1h, one row per disk",
        "noDataMessage": "No disk space alerts.",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatRules": [
            {
              "columnMatch": "DiskStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Critical",
                    "representation": "error",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "success",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "filter": true,
          "rowLimit": 2000
        }
      },
      "styleSettings": {
        "showBorder": true
      },
      "name": "DiskAlerts"
    },
    {
      "type": 1,
      "content": {
        "json": "<h3 style=\"color:#0078d4;border-left:4px solid #0078d4;padding-left:12px;font-family:'Segoe UI',sans-serif;margin:24px 0 4px 0\">🔍 Operational Views</h3>"
      },
      "name": "section-operational"
    },
    {
  "type": 3,
  "content": {
    "version": "KqlItem/1.0",
    "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| where isempty(\"{VM}\") or name =~ \"{VM}\"\n| extend\n    JoinSub = subscriptionId,\n    JoinRG = tolower(resourceGroup),\n    JoinVMId = tolower(id),\n    PowerState = tostring(properties.extended.instanceView.powerState.displayStatus),\n    OSType = tostring(properties.storageProfile.osDisk.osType),\n    VMSize = tostring(properties.hardwareProfile.vmSize),\n    VMInsightsUrl = strcat('https://portal.azure.com/#resource', id, '/insights/performance')\n| join kind=leftouter (\n    ResourceContainers\n    | where type =~ 'microsoft.resources/subscriptions/resourcegroups'\n    | extend\n        JoinSub = subscriptionId,\n        JoinRG = tolower(name)\n    | project\n        JoinSub,\n        JoinRG,\n        ApplicationName = coalesce(tostring(tags['Application name']), tostring(tags['Application Name']), tostring(tags['ApplicationName']), tostring(tags['AppName']), tostring(tags['Project']), tostring(tags['project'])),\n        ApproverName = coalesce(tostring(tags['Approver name']), tostring(tags['Approver Name']), tostring(tags['ApproverName']), tostring(tags['Approver'])),\n        BusinessOwner = coalesce(tostring(tags['Business Owner']), tostring(tags['BusinessOwner']), tostring(tags['Owner'])),\n        Company = coalesce(tostring(tags['Company']), tostring(tags['company'])),\n        CostCenter = coalesce(tostring(tags['Cost Center']), tostring(tags['CostCenter']), tostring(tags['Cost center']))\n) on JoinSub, JoinRG\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.devtestlab/schedules'\n    | extend\n        JoinVMId = tolower(tostring(properties['targetResourceId'])),\n        AutoShutdownStatus = tostring(properties['status']),\n        ShutdownTime = tostring(properties['dailyRecurrence']['time'])\n    | project\n        JoinVMId,\n        AutoShutdownStatus,\n        ShutdownTime\n) on JoinVMId\n| join kind=leftouter (\n    Resources\n    | where type =~ 'microsoft.network/networkinterfaces'\n    | extend JoinVMId = tolower(tostring(properties['virtualMachine']['id']))\n    | mv-expand ipconfig = properties['ipConfigurations']\n    | extend PrivateIP = tostring(ipconfig['properties']['privateIPAddress'])\n    | where isnotempty(JoinVMId) and isnotempty(PrivateIP)\n    | summarize PrivateIPs = strcat_array(make_set(PrivateIP), ', ') by JoinVMId\n) on JoinVMId\n| extend\n    AutoShutdownStatus = iff(isempty(AutoShutdownStatus), 'Disabled', AutoShutdownStatus),\n    ShutdownTime = iff(isempty(ShutdownTime), '-', ShutdownTime),\n    PrivateIPs = iff(isempty(PrivateIPs), '-', PrivateIPs),\n    ApplicationName = iff(isempty(ApplicationName), '-', ApplicationName),\n    ApproverName = iff(isempty(ApproverName), '-', ApproverName),\n    BusinessOwner = iff(isempty(BusinessOwner), '-', BusinessOwner),\n    Company = iff(isempty(Company), '-', Company),\n    CostCenter = iff(isempty(CostCenter), '-', CostCenter)\n| project\n    VMName = name,\n    ResourceGroup = resourceGroup,\n    Location = location,\n    OSType,\n    VMSize,\n    PowerState,\n    PrivateIPs,\n    AutoShutdownStatus,\n    ShutdownTime,\n    ApplicationName,\n    ApproverName,\n    BusinessOwner,\n    Company,\n    CostCenter,\n    id,\n    VMInsightsUrl\n| order by VMName asc",
    "size": 0,
    "title": "VM Inventory",
    "queryType": 1,
    "resourceType": "microsoft.resourcegraph/resources",
    "crossComponentResources": [
      "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"
    ],
    "gridSettings": {
      "formatRules": [
        {
          "columnMatch": "PowerState",
          "formatter": 18,
          "formatOptions": {
            "thresholdsOptions": "icons",
            "thresholdsGrid": [
              {
                "operator": "==",
                "thresholdValue": "VM running",
                "representation": "success",
                "text": "{0}{1}"
              },
              {
                "operator": "==",
                "thresholdValue": "VM deallocated",
                "representation": "stopped",
                "text": "{0}{1}"
              },
              {
                "operator": "Default",
                "thresholdValue": null,
                "representation": "warning",
                "text": "{0}{1}"
              }
            ]
          }
        },
        {
          "columnMatch": "AutoShutdownStatus",
          "formatter": 18,
          "formatOptions": {
            "thresholdsOptions": "icons",
            "thresholdsGrid": [
              {
                "operator": "==",
                "thresholdValue": "Enabled",
                "representation": "success",
                "text": "{0}{1}"
              },
              {
                "operator": "==",
                "thresholdValue": "Disabled",
                "representation": "error",
                "text": "{0}{1}"
              },
              {
                "operator": "Default",
                "thresholdValue": null,
                "representation": "warning",
                "text": "{0}{1}"
              }
            ]
          }
        },
        {
          "columnMatch": "id",
          "formatter": 13,
          "formatOptions": {
            "linkTarget": "Resource",
            "showIcon": true,
            "linkLabel": "Open VM"
          }
        },
        {
          "columnMatch": "VMInsightsUrl",
          "formatter": 13,
          "formatOptions": {
            "linkTarget": "Url",
            "linkLabel": "VM Insights"
          }
        }
      ],
      "filter": true,
      "rowLimit": 1000,
      "labelSettings": [
        {
          "columnId": "id",
          "label": "Azure VM Blade"
        },
        {
          "columnId": "VMInsightsUrl",
          "label": "VM Insights"
        },
        {
          "columnId": "PrivateIPs",
          "label": "Private IPs"
        },
        {
          "columnId": "AutoShutdownStatus",
          "label": "Auto Shutdown"
        },
        {
          "columnId": "ShutdownTime",
          "label": "Shutdown Time"
        },
        {
          "columnId": "ApplicationName",
          "label": "Application"
        },
        {
          "columnId": "ApproverName",
          "label": "Approver"
        },
        {
          "columnId": "BusinessOwner",
          "label": "Business Owner"
        },
        {
          "columnId": "CostCenter",
          "label": "Cost Center"
        }
      ]
    }
  },
  "styleSettings": {
    "showBorder": true
  },
  "name": "VMInventory"
},
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Heartbeat\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize LastHeartbeat=max(TimeGenerated) by Computer\n| extend Status=iff(LastHeartbeat > ago(15m),'Online','Offline')\n| extend MinutesSinceHeartbeat = datetime_diff('minute', now(), LastHeartbeat)\n| project Computer, Status, LastHeartbeat, MinutesSinceHeartbeat\n| order by Computer asc",
        "size": 0,
        "title": "VM Status Grid",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatRules": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Online",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "error",
                    "text": "{0}{1}"
