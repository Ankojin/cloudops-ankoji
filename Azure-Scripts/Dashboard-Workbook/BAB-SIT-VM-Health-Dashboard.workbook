      "conditionalVisibility": {
        "parameterName": "DrillTile",
        "comparison": "isEqualTo",
        "value": "cpu_high"
      },
      "styleSettings": { "showBorder": true },
      "name": "DrillHighCPU"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Perf\n| where _ResourceId !contains '{ExcludedRG}'\n| where CounterName in ('% Committed Bytes In Use','% Used Memory')\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| where TimeGenerated > ago(1h)\n| summarize AvgMemory=round(avg(CounterValue),1) by Computer\n| where AvgMemory > 90\n| order by AvgMemory desc",
        "size": 0,
