          "filter": true
        }
      },
      "styleSettings": {
        "showBorder": true
      },
      "name": "StatusGrid"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Heartbeat\n| where _ResourceId !contains '{ExcludedRG}'\n| where isempty(\"{VM}\") or Computer =~ \"{VM}\"\n| summarize LastHeartbeat=max(TimeGenerated), HeartbeatCount=count() by Computer\n| where LastHeartbeat <= ago(15m)\n| extend MinutesSinceHeartbeat = datetime_diff('minute', now(), LastHeartbeat)\n| project Computer, LastHeartbeat, MinutesSinceHeartbeat, HeartbeatCount\n| order by MinutesSinceHeartbeat desc",
        "size": 0,
        "title": "Failed Heartbeats (>15 min)",
        "noDataMessage": "No failed heartbeats detected.",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77/resourceGroups/bab-sit-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-sit-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "filter": true
        }
      },
      "styleSettings": {
        "showBorder": true
      },
      "name": "FailedHeartbeats"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines/extensions'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| where name in~ ('AzureMonitorWindowsAgent','AzureMonitorLinuxAgent')\n| extend ProvisioningState = tostring(properties.provisioningState)\n| extend VMName = tostring(split(id,'/')[8])\n| project VMName, ExtensionName=name, ResourceGroup=resourceGroup, ProvisioningState\n| order by ProvisioningState asc",
        "size": 0,
        "title": "AMA Extension Health",
        "noDataMessage": "No AMA extensions found. Ensure Azure Monitor Agent is deployed to VMs.",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
