    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend PowerState = tostring(properties.extended.instanceView.powerState.displayStatus)\n| extend OSType = tostring(properties.storageProfile.osDisk.osType)\n| extend VMSize = tostring(properties.hardwareProfile.vmSize)\n| project VMName=name, ResourceGroup=resourceGroup, Location=location, OSType, VMSize, PowerState\n| order by VMName asc",
        "size": 0,
        "title": "All VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": ["/subscriptions/e48414cd-f96d-4414-ae9e-da7fec844f77"]
      },
      "conditionalVisibility": {
        "parameterName": "DrillTile",
        "comparison": "isEqualTo",
        "value": "total"
      },
      "styleSettings": { "showBorder": true },
      "name": "DrillTotal"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "Resources\n| where type =~ 'microsoft.compute/virtualmachines'\n| where resourceGroup !startswith 'aro-infra'\n| where isempty(\"{ResourceGroup}\") or resourceGroup =~ \"{ResourceGroup}\"\n| extend powerState = tostring(properties.extended.instanceView.powerState.code)\n| where powerState =~ 'PowerState/running'\n| extend OSType = tostring(properties.storageProfile.osDisk.osType)\n| extend VMSize = tostring(properties.hardwareProfile.vmSize)\n| project VMName=name, ResourceGroup=resourceGroup, Location=location, OSType, VMSize\n| order by VMName asc",
        "size": 0,
        "title": "Running VMs",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
