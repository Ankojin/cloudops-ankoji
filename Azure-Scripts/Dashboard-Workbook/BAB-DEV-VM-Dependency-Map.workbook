{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "sub",
            "version": "KqlParameterItem/1.0",
            "name": "Subscription",
            "type": 6,
            "multiSelect": true,
            "value": [
              "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248"
            ]
          },
          {
            "id": "rg",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroup",
            "type": 5,
            "multiSelect": true,
            "value": [
              "Azure Monitor"
            ]
          },
          {
            "id": "time",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "value": {
              "durationMs": 86400000
            }
          },
          {
            "id": "vm",
            "version": "KqlParameterItem/1.0",
            "name": "VM",
            "label": "Virtual Machine",
            "type": 2,
            "isRequired": false,
            "multiSelect": false,
            "query": "VMConnection\n| where TimeGenerated {TimeRange}\n| summarize by Computer\n| sort by Computer asc\n| project value = Computer, label = Computer",
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces",
            "crossComponentResources": [
              "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248/resourceGroups/bab-dev-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-dev-all-wrkspc-swec-01"
            ]
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters - 0"
    },
    {
      "type": 1,
      "content": {
        "json": "# BAB DEV VM Dependency Map\nIncludes VMConnection queries.\n**Scope:** Private IPs only (10.0.0.0/8) for source and destination."
      },
      "name": "text - 1"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "VMConnection\n| where TimeGenerated {TimeRange}\n| where ipv4_is_in_range(SourceIp, '10.0.0.0/8')\n| where ipv4_is_in_range(DestinationIp, '10.0.0.0/8')\n| where SourceIp !in ('10.189.250.5', '10.189.250.4') and DestinationIp !in ('10.189.250.5', '10.189.250.4')\n| where SourceIp != DestinationIp\n| where Direction == 'inbound'\n| where isempty('{VM}') or Computer == '{VM}'\n| summarize\n    Connections = count(),\n    BytesSent = sum(BytesSent),\n    BytesReceived = sum(BytesReceived),\n    LastSeen = max(TimeGenerated)\n    by Computer, SourceIp, DestinationIp, DestinationPort, Protocol\n| sort by Connections desc\n| project-rename RemoteIp = SourceIp, LocalIp = DestinationIp",
        "size": 0,
        "title": "VM Connections — Inbound (Private IPs only)",
        "showOpenInBlade": true,
        "showExportToExcel": true,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248/resourceGroups/bab-dev-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-dev-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Connections",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">=",
                    "thresholdValue": "1000",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "100",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "BytesSent",
              "formatter": 4,
              "formatOptions": {},
              "numberFormat": {
                "unit": 2,
                "options": {
                  "style": "decimal",
                  "maximumFractionDigits": 2
                }
              }
            },
            {
              "columnMatch": "BytesReceived",
              "formatter": 4,
              "formatOptions": {},
              "numberFormat": {
                "unit": 2,
                "options": {
                  "style": "decimal",
                  "maximumFractionDigits": 2
                }
              }
            }
          ],
          "rowLimit": 10000,
          "exportToExcelOptions": "all",
          "filter": true
        }
      },
      "name": "query - 2-inbound"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "VMConnection\n| where TimeGenerated {TimeRange}\n| where ipv4_is_in_range(SourceIp, '10.0.0.0/8')\n| where ipv4_is_in_range(DestinationIp, '10.0.0.0/8')\n| where SourceIp !in ('10.189.250.5', '10.189.250.4') and DestinationIp !in ('10.189.250.5', '10.189.250.4')\n| where SourceIp != DestinationIp\n| where Direction == 'outbound'\n| where isempty('{VM}') or Computer == '{VM}'\n| summarize\n    Connections = count(),\n    BytesSent = sum(BytesSent),\n    BytesReceived = sum(BytesReceived),\n    LastSeen = max(TimeGenerated)\n    by Computer, SourceIp, DestinationIp, DestinationPort, Protocol\n| sort by Connections desc\n| project-rename LocalIp = SourceIp, RemoteIp = DestinationIp",
        "size": 0,
        "title": "VM Connections — Outbound (Private IPs only)",
        "showOpenInBlade": true,
        "showExportToExcel": true,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248/resourceGroups/bab-dev-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-dev-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Connections",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">=",
                    "thresholdValue": "1000",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "100",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "green",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "BytesSent",
              "formatter": 4,
              "formatOptions": {},
              "numberFormat": {
                "unit": 2,
                "options": {
                  "style": "decimal",
                  "maximumFractionDigits": 2
                }
              }
            },
            {
              "columnMatch": "BytesReceived",
              "formatter": 4,
              "formatOptions": {},
              "numberFormat": {
                "unit": 2,
                "options": {
                  "style": "decimal",
                  "maximumFractionDigits": 2
                }
              }
            }
          ],
          "rowLimit": 10000,
          "exportToExcelOptions": "all",
          "filter": true
        }
      },
      "name": "query - 2-outbound"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "VMConnection\n| where TimeGenerated {TimeRange}\n| where ipv4_is_in_range(SourceIp, '10.0.0.0/8')\n| where ipv4_is_in_range(DestinationIp, '10.0.0.0/8')\n| where SourceIp !in ('10.189.250.5', '10.189.250.4')\n| where SourceIp != DestinationIp\n| where isempty('{VM}') or Computer == '{VM}'\n| summarize\n    Connections = count(),\n    LastSeen = max(TimeGenerated)\n    by Computer, _ResourceId\n| where isnotempty(_ResourceId) and isnotempty(Computer)\n| extend\n    subId  = extract('/subscriptions/([^/]+)', 1, _ResourceId),\n    rgName = extract('/resourcegroups/([^/]+)', 1, _ResourceId),\n    vmName = extract('/virtualmachines/([^/]+)', 1, _ResourceId)\n| extend resourceId = strcat('/subscriptions/', subId, '/resourceGroups/', rgName, '/providers/Microsoft.Compute/virtualMachines/', vmName)\n| extend jsonScope = strcat('{\"scopes\":{\"hybrid\":{\"computer\":{\"id\":\"', resourceId, '\",\"name\":\"', vmName, '\"},\"workspace\":{\"id\":\"/unknown\"}},\"azure\":{\"resource\":{\"id\":\"', resourceId, '\",\"displayName\":\"', vmName, '\"},\"resourceType\":\"VirtualMachine\"}}}')\n| extend MapLink = strcat('https://portal.azure.com/#view/Microsoft_Azure_WorkloadInsights/AtScaleVmInsightsBladeViewModel/selectedTab~/2/sourceType/SingleVmScale/scopeSelections~/', url_encode(jsonScope), '/subscriptionId/', subId, '/doNotSaveScope~/true')\n| project Computer, Connections, LastSeen, MapLink\n| sort by Computer asc",
        "size": 0,
        "title": "Open VM Insights — click link to open full interactive VM Insights per VM",
        "showOpenInBlade": true,
        "showExportToExcel": true,
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248/resourceGroups/bab-dev-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-dev-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "MapLink",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "ExternalUrl",
                "linkLabel": "Open in VM Insights Map"
              }
            }
          ],
          "exportToExcelOptions": "all",
          "filter": true
        }
      },
      "name": "query - vm-insights-links"
    },
    {
      "type": 1,
      "content": {
        "json": "<h3 style=\"color:#0078d4;border-left:4px solid #0078d4;padding-left:12px;font-family:'Segoe UI',sans-serif;margin:24px 0 4px 0\">🔍 Deeper Analysis</h3>"
      },
      "name": "text - deeper-analysis"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "VMConnection\n| where TimeGenerated {TimeRange}\n| where LinksFailed > 0\n| where ipv4_is_in_range(SourceIp, '10.0.0.0/8')\n| where ipv4_is_in_range(DestinationIp, '10.0.0.0/8')\n| where SourceIp !in ('10.189.250.5', '10.189.250.4') and DestinationIp !in ('10.189.250.5', '10.189.250.4')\n| where SourceIp != DestinationIp\n| where isempty('{VM}') or Computer == '{VM}'\n| summarize\n    TotalFailed = sum(LinksFailed),\n    LastSeen = max(TimeGenerated)\n    by Computer, SourceIp, DestinationIp, DestinationPort, Protocol\n| sort by TotalFailed desc\n| project-rename LocalIp = SourceIp, RemoteIp = DestinationIp",
        "size": 0,
        "title": "Failed Connections",
        "showOpenInBlade": true,
        "showExportToExcel": true,
        "noDataMessage": "No failed connections detected in the selected time range.",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248/resourceGroups/bab-dev-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-dev-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatRules": [
            {
              "columnMatch": "TotalFailed",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "redBright",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "exportToExcelOptions": "all",
          "rowLimit": 10000,
          "filter": true
        }
      },
      "name": "query - failed-connections"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "VMConnection\n| where TimeGenerated {TimeRange}\n| where isnotempty(MaliciousIp)\n| where isempty('{VM}') or Computer == '{VM}'\n| project TimeGenerated, Computer, RemoteIp = MaliciousIp, Severity, Description, IndicatorThreatType, Confidence, LastReportedDateTime\n| sort by Severity desc",
        "size": 0,
        "title": "Malicious IP Connections",
        "showOpenInBlade": true,
        "showExportToExcel": true,
        "noDataMessage": "No connections to malicious IPs detected.",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/43cc4f11-ffb1-4a0d-8420-0ba3746b4248/resourceGroups/bab-dev-wrkspace-swec-rg-01/providers/Microsoft.OperationalInsights/workspaces/bab-dev-all-wrkspc-swec-01"
        ],
        "gridSettings": {
          "formatRules": [
            {
              "columnMatch": "Severity",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "High",
                    "representation": "error",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Medium",
                    "representation": "warning",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "unknown",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "exportToExcelOptions": "all",
          "filter": true
        }
      },
      "name": "query - malicious-ip"
    }
  ],
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
