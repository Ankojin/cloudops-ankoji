{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "workspaceId": {
        "type": "string"
      }
    },
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "schedule": {
            "hours": [8],
            "minutes": [0]
          },
          "startTime": "2026-07-01T08:00:00",
          "timeZone": "Arab Standard Time"
        }
      }
    },
    "actions": {
      "Run_Query": {
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "@{concat('https://api.loganalytics.azure.com/v1/workspaces/', parameters('workspaceId'), '/query')}",
          "headers": {
            "Content-Type": "application/json",
            "Prefer": "wait=600"
          },
          "body": {
            "query": "Perf | where TimeGenerated > ago(25h) | where ObjectName in~ ('Logical Disk', 'LogicalDisk') | where CounterName in ('% Free Space', 'Free Megabytes') | where InstanceName !in~ ('_Total', 'Instances', 'total') | where InstanceName !startswith 'HarddiskVolume' | where InstanceName !startswith '/dev' | where InstanceName !startswith '/sys' | where InstanceName !startswith '/run' | where InstanceName !startswith '/proc' | where InstanceName !startswith '/boot' | where InstanceName !startswith '/home' | where InstanceName !startswith '/tmp' | where InstanceName !in~ ('tmpfs', 'overlay', 'none', 'udev') | evaluate pivot(CounterName, avg(CounterValue), Computer, InstanceName) | project Computer, Disk = InstanceName, FreePct = round(['% Free Space'], 1), FreeGB = round(['Free Megabytes'] / 1024, 1), TotalGB = round((['Free Megabytes'] / 1024) / (['% Free Space'] / 100), 1), UsedGB = round((['Free Megabytes'] / 1024) * (100 - ['% Free Space']) / ['% Free Space'], 1) | where isnotnull(FreePct) and isnotnull(TotalGB) and isnotnull(UsedGB) and TotalGB > 0 and TotalGB < 102400 | where FreePct < 20 | order by FreePct asc"
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://api.loganalytics.io"
          },
          "retryPolicy": {
            "type": "fixed",
            "count": 3,
            "interval": "PT30S"
          }
        }
      },
      "Handle_Query_Failure": {
        "runAfter": {
          "Run_Query": [
            "Failed",
            "TimedOut"
          ]
        },
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {
            "code": "QueryFailed",
            "message": "Log Analytics query failed or timed out after 3 retries. Check the Logic App run history for details."
          }
        }
      },
      "Initialize_HTML": {
        "runAfter": {
          "Run_Query": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "HtmlBody",
              "type": "string",
              "value": "<html><body><p>Hello Team,</p><p>The following disks are below <b>20%</b> free space:</p><table border='1' style='border-collapse:collapse;font-family:Arial;'><tr style='background-color:#0078D4;color:white;'><th style='padding:8px'>Server</th><th style='padding:8px'>Drive</th><th style='padding:8px'>Free Space %</th><th style='padding:8px'>Free (GB)</th><th style='padding:8px'>Used (GB)</th><th style='padding:8px'>Total (GB)</th><th style='padding:8px'>Severity</th></tr>"
            }
          ]
        }
      },
      "Initialize_CSV": {
        "runAfter": {
          "Initialize_HTML": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "CsvBody",
              "type": "string",
              "value": "\"Server\",\"Drive\",\"Free Space %\",\"Free (GB)\",\"Used (GB)\",\"Total (GB)\",\"Severity\"\n"
            }
          ]
        }
      },
      "Initialize_UniqueServers": {
        "runAfter": {
          "Initialize_CSV": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "UniqueServers",
              "type": "array",
              "value": []
            }
          ]
        }
      },
      "Initialize_CriticalCount": {
        "runAfter": {
          "Initialize_UniqueServers": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "CriticalCount",
              "type": "integer",
              "value": 0
            }
          ]
        }
      },
      "Initialize_WarningCount": {
        "runAfter": {
          "Initialize_CriticalCount": [
            "Succeeded"
          ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "WarningCount",
              "type": "integer",
              "value": 0
            }
          ]
        }
      },
      "Check_Any_Found": {
        "runAfter": {
          "Initialize_WarningCount": [
            "Succeeded"
          ]
        },
        "type": "If",
        "expression": "@greater(length(body('Run_Query')?['tables'][0]['rows']),0)",
        "actions": {
          "Get_SendGrid_Key": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://bab-core-kv-swec-01.vault.azure.net/secrets/SendGridApiKey?api-version=7.4",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://vault.azure.net"
              },
              "retryPolicy": {
                "type": "fixed",
                "count": 3,
                "interval": "PT30S"
              }
            }
          },
          "For_each_Disk": {
            "runAfter": {
              "Get_SendGrid_Key": [
                "Succeeded"
              ]
            },
            "type": "Foreach",
            "foreach": "@body('Run_Query')['tables'][0]['rows']",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "actions": {
              "Append_Row": {
                "type": "AppendToStringVariable",
                "inputs": {
                  "name": "HtmlBody",
                  "value": "<tr style='@{if(less(float(items('For_each_Disk')[2]), 10), 'background-color:#FFD7D7', 'background-color:#FFF3CD')}'><td style='padding:8px'>@{items('For_each_Disk')[0]}</td><td style='padding:8px'>@{items('For_each_Disk')[1]}</td><td style='padding:8px;font-weight:bold;color:@{if(less(float(items('For_each_Disk')[2]), 10), '#C00000', '#9C5700')}'>@{items('For_each_Disk')[2]}%</td><td style='padding:8px'>@{items('For_each_Disk')[3]} GB</td><td style='padding:8px'>@{items('For_each_Disk')[5]} GB</td><td style='padding:8px'>@{items('For_each_Disk')[4]} GB</td><td style='padding:8px;font-weight:bold;color:@{if(less(float(items('For_each_Disk')[2]), 10), '#C00000', '#9C5700')}'>@{if(less(float(items('For_each_Disk')[2]), 10), 'Critical', 'Warning')}</td></tr>"
                }
              },
              "Append_CSV_Row": {
                "runAfter": {
                  "Append_Row": [
                    "Succeeded"
                  ]
                },
                "type": "AppendToStringVariable",
                "inputs": {
                  "name": "CsvBody",
                  "value": "\"@{items('For_each_Disk')[0]}\",\"@{items('For_each_Disk')[1]}\",\"@{items('For_each_Disk')[2]}\",\"@{items('For_each_Disk')[3]}\",\"@{items('For_each_Disk')[5]}\",\"@{items('For_each_Disk')[4]}\",\"@{if(less(float(items('For_each_Disk')[2]), 10), 'Critical', 'Warning')}\"\n"
                }
              },
              "Track_Server": {
                "runAfter": {
                  "Append_CSV_Row": [
                    "Succeeded"
                  ]
                },
                "type": "If",
                "expression": "@not(contains(variables('UniqueServers'), items('For_each_Disk')[0]))",
                "actions": {
                  "Add_Server": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "UniqueServers",
                      "value": "@items('For_each_Disk')[0]"
                    }
                  }
                },
                "else": {
                  "actions": {}
                }
              },
              "Increment_Counter": {
                "runAfter": {
                  "Track_Server": [
                    "Succeeded"
                  ]
                },
                "type": "If",
                "expression": "@less(float(items('For_each_Disk')[2]), 10)",
                "actions": {
                  "Increment_CriticalCount": {
                    "type": "IncrementVariable",
                    "inputs": {
                      "name": "CriticalCount",
                      "value": 1
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Increment_WarningCount": {
                      "type": "IncrementVariable",
                      "inputs": {
                        "name": "WarningCount",
                        "value": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "Close_HTML": {
            "runAfter": {
              "For_each_Disk": [
                "Succeeded"
              ]
            },
            "type": "AppendToStringVariable",
            "inputs": {
              "name": "HtmlBody",
              "value": "</table><br/><p><b>Summary:</b> <span style='color:#C00000;font-weight:bold;'>@{variables('CriticalCount')} Critical</span> &nbsp;|&nbsp; <span style='color:#9C5700;font-weight:bold;'>@{variables('WarningCount')} Warning</span> &nbsp;|&nbsp; @{length(variables('UniqueServers'))} server(s) affected</p><p style='color:#666666;font-size:12px;'>Report generated: @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')} UTC &nbsp;&mdash;&nbsp; This is an automated notification from Azure Monitor.</p></body></html>"
            }
          },
          "Send_Email": {
            "runAfter": {
              "Close_HTML": [
                "Succeeded"
              ]
            },
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "https://api.sendgrid.com/v3/mail/send",
              "headers": {
                "Authorization": "@{concat('Bearer ', body('Get_SendGrid_Key')['value'])}",
                "Content-Type": "application/json"
              },
              "body": {
                "personalizations": [
                  {
                    "to": [
                      {
                        "email": "MailgroupCloudServices@bankalbilad.com.sa"
                      }
                    ],
                    "subject": "@{concat('[', if(greater(variables('CriticalCount'), 0), 'CRITICAL', 'WARNING'), '] Disk Space Alert - ', string(length(variables('UniqueServers'))), ' server(s) | ', string(variables('CriticalCount')), ' Critical, ', string(variables('WarningCount')), ' Warning [', formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm'), ' UTC]')}"
                  }
                ],
                "from": {
                  "email": "cloudops@albtests.com"
                },
                "content": [
                  {
                    "type": "text/html",
                    "value": "@{variables('HtmlBody')}"
                  }
                ],
                "attachments": [
                  {
                    "content": "@{base64(variables('CsvBody'))}",
                    "type": "text/csv",
                    "filename": "@{concat('DiskSpaceAlert-', formatDateTime(utcNow(), 'yyyyMMdd-HHmm'), '.csv')}",
                    "disposition": "attachment"
                  }
                ]
              },
              "retryPolicy": {
                "type": "fixed",
                "count": 3,
                "interval": "PT30S"
              }
            }
          }
        },
        "else": {
          "actions": {
            "No_Alerts_Terminate": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "workspaceId": {
      "value": "2b769ac8-2757-4611-a534-891be5dcb3b6"
    }
  }
}
