# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password

# ── DEV cluster ───────────────────────────────────────────────
DEV_API=https://api.babdevaro.albtests.com:6443
DEV_TOKEN=sha256~your-dev-service-account-token
DEV_ENV_LABEL=DEV

# ── SIT cluster ───────────────────────────────────────────────
SIT_API=https://api.babsitaro.albtests.com:6443
SIT_TOKEN=sha256~your-sit-service-account-token
OCP_INSECURE_SKIP_TLS_VERIFY=false
# OCP_CA_FILE=/path/to/private-cluster-ca.pem
SIT_ENV_LABEL=SIT
